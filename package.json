{
  "name": "asds-electron",
  "version": "1.0.0",
  "description": "ASDS - Academic Similarity Detection System",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.asds.similarityscope",
    "productName": "ASDS Desktop",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python_bridge",
        "to": "python_bridge",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "similarityscope/core",
        "to": "similarityscope/core",
        "filter": [
          "**/*.py"
        ]
      }
    ]
  }
}
